# Copy this file to .env and fill in your own values. .env is never committed.
# Bitvavo API key: enable TRADE only. Never enable WITHDRAW. Restrict it to your server's IP.
BITVAVO_API_KEY=
BITVAVO_API_SECRET=

# Gmail alerts: use a Gmail "app password", not your normal password.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_APP_PASSWORD=

# Optional, only if AI news scoring is turned on later.
ANTHROPIC_API_KEY=
